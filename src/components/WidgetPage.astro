---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_URL } from '../data/site-config';
import { route, type Locale } from '../i18n/routes';
interface Props { lang: Locale }
const { lang } = Astro.props;
const es = lang === 'es';
const src = `/embed/asvab-score/${es ? '?lang=es' : ''}`;
const code = `<iframe src="${SITE_URL}/embed/asvab-score/" title="${es ? 'Calculadora de puntaje del ASVAB' : 'ASVAB score calculator'}" width="100%" height="900" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title={es ? 'Insertar la calculadora del ASVAB 2026 en su sitio web' : 'Embed the ASVAB score calculator 2026 on your own site'} description={es ? 'Escuelas, consejeros y sitios comunitarios pueden insertar la calculadora de puntaje del ASVAB 2026, con el AFQT y los mínimos por rama, en una línea de código. Gratis.' : 'Schools, counselors and community sites can embed the 2026 ASVAB score calculator, with the AFQT and branch minimums, in one line of code. Free, with no cookie set.'} lang={lang} noindex={true} breadcrumbs={[{ label: es ? 'Insertar' : 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{es ? 'Insertar la calculadora' : 'Embed the calculator'}</h1>
    <p class="mt-3 text-lg text-navy-700">{es ? 'Una línea de código. La calculadora insertada usa las mismas tablas oficiales que este sitio.' : 'One line of code. The embedded calculator uses the same official tables as this site.'}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>{es ? 'La calculadora funciona en el navegador del visitante y no nos envía nada, ni a usted. Mantenga el enlace bajo la calculadora: así los lectores encuentran las fuentes y el método.' : 'The calculator runs in the visitor’s browser and sends nothing to us or to you. Please keep the link under the calculator: it is how readers find the sources and the method.'} <a href={route('method', lang)}>{es ? 'Método' : 'Method'}</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={src} title={es ? 'Calculadora de puntaje del ASVAB' : 'ASVAB score calculator'} width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
